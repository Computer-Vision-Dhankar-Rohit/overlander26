# Copy this file to .env and fill in your values
# Never commit .env to git

# From Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=your_bot_token_here

# Optional: restrict bot to one channel (right-click channel → Copy Channel ID)
# Leave blank to respond in ALL channels
DISCORD_CHANNEL_ID=

# OpenAI API key — used by LangChain agent
OPENAI_API_KEY=sk-...

# Port for uvicorn (default 8001 — different from WhatsApp server on 8000)
PORT=8001
