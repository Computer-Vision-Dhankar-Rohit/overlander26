# Copy this file to .env and fill in your values
# Never commit .env to git

# A secret string you choose — must match what you enter in the Meta App Dashboard
WHATSAPP_VERIFY_TOKEN=my_secret_verify_token

# From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=1234567890

# Temporary or permanent access token from Meta App Dashboard
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxx

# Port for uvicorn (optional, default 8000)
PORT=8000
